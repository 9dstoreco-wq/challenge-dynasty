{
  "name": "challenge-dynasty",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check-routes": "node scripts/check-routes.mjs",
    "check-sql": "node scripts/check-sql.mjs",
    "check-sql-contracts": "node scripts/check-sql-contracts.mjs",
    "check-rpc-status-literals": "node scripts/check-rpc-status-literals.mjs",
    "check-error-sanitization": "node scripts/check-error-sanitization.mjs",
    "check-core-flow": "node scripts/check-core-flow.mjs",
    "check-production": "node scripts/check-production.mjs",
    "check-hardening": "node scripts/check-hardening.mjs",
    "verify-all": "npm run check-routes && npm run check-sql && npm run check-sql-contracts && npm run check-rpc-status-literals && npm run check-error-sanitization && npm run check-core-flow && npm run check-production && npm run check-hardening && npm test",
    "check-env": "node scripts/check-env.mjs",
    "verify:release": "npm run release-doctor",
    "release-doctor": "node scripts/release-doctor.mjs",
    "lint": "eslint app components lib --max-warnings 0",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "2.1.1",
    "lucide-react": "^1.52.0",
    "next": "15.5.24",
    "next-intl": "^4.14.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "2.5.5"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
